<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#050814" />
    <link rel="icon" href="assets/img/favicon.ico" />
    <meta property="og:image" content="assets/img/logo.png" />
    <title>// NEURAL_PORTAL :: INTL_GATEWAY_2026</title>

    <!-- Preconnect distinctive fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Share+Tech+Mono&family=Rajdhani:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="assets/css/portal-landing-page-styles.css" />
  </head>

  <body>
    <!-- ===== BACKGROUND STACK (depth 0 — furthest) ===== -->
    <div class="bg-stack" aria-hidden="true">
      <div class="bg-tint"></div>
      <div class="bg-vignette"></div>

      <!-- Matrix rain canvas layer -->
      <canvas class="matrix-rain" id="matrixRain"></canvas>

      <!-- 3D perspective grid floor -->
      <div class="grid-floor">
        <div class="grid-floor__mesh"></div>
      </div>

      <!-- Scan / noise overlays -->
      <div class="scan-lines"></div>
      <div class="scan-sweep"></div>
      <div class="noise"></div>
    </div>

    <!-- ===== HUD CHROME (fixed overlays) ===== -->
    <div class="hud" aria-hidden="true">
      <div class="hud__corner hud__corner--tl">
        <span class="hud__tag">NODE::SG-01</span>
        <span class="hud__status"><i class="dot"></i> LINK SECURED</span>
      </div>
      <div class="hud__corner hud__corner--tr">
        <span class="hud__tag">AES-256 / TLS 1.3</span>
        <span class="hud__status"><i class="dot dot--warn"></i> ENCRYPTING</span>
      </div>
      <div class="hud__corner hud__corner--bl">
        <span class="hud__tag" id="hudLatency">PING 012 ms</span>
      </div>
      <div class="hud__corner hud__corner--br">
        <span class="hud__tag" id="hudTime">--:--:--</span>
      </div>

      <div class="hud__rail hud__rail--left">
        <span>0x7F</span><span>0x3A</span><span>0xC1</span><span>0x09</span>
        <span>0xFE</span><span>0x22</span><span>0xB4</span><span>0x05</span>
      </div>
      <div class="hud__rail hud__rail--right">
        <span>AUTH</span><span>SEAL</span><span>TRACE</span><span>WIPE</span>
      </div>
    </div>

    <!-- ===== 3D SCENE ===== -->
    <main class="scene" id="scene">
      <!-- Terminal boot line -->
      <div class="term" data-depth="1">
        <span class="term__prompt">root@fly88:~/portal#</span>
        <span class="term__cmd">./init --secure --region=ASIA --encrypt=AES-256</span>
        <span class="term__caret"></span>
      </div>

      <!-- 3D Holographic Logo -->
      <header class="logo-holo" data-depth="2">
        <span class="logo-holo__ring logo-holo__ring--1"></span>
        <span class="logo-holo__ring logo-holo__ring--2"></span>
        <img
          src="assets/img/logo-fly88.png"
          alt="Logo thương hiệu"
          class="logo-holo__img"
        />
        <span class="logo-holo__glitch"></span>
      </header>

      <!-- Floating 3D cube accent -->
      <div class="cube" data-depth="3" aria-hidden="true">
        <span class="cube__face cube__face--front"></span>
        <span class="cube__face cube__face--back"></span>
        <span class="cube__face cube__face--right"></span>
        <span class="cube__face cube__face--left"></span>
        <span class="cube__face cube__face--top"></span>
        <span class="cube__face cube__face--bottom"></span>
      </div>

      <!-- Country node grid (3D tilting cards) -->
      <nav class="nodes" data-depth="2" aria-label="Chọn cổng quốc gia">
        <button class="node" onclick="redirectToSite()">
          <span class="node__corner node__corner--tl"></span>
          <span class="node__corner node__corner--tr"></span>
          <span class="node__corner node__corner--bl"></span>
          <span class="node__corner node__corner--br"></span>
          <span class="node__id">01 // VN</span>
          <div class="node__flag-wrap">
            <img src="assets/img/vietnam.gif" alt="Việt Nam" class="node__flag" />
            <span class="node__ring"></span>
          </div>
          <span class="node__name">VIỆT NAM</span>
          <span class="node__meta">PORT 8443 · PRIMARY</span>
        </button>

        <button class="node" onclick="redirectToSite()">
          <span class="node__corner node__corner--tl"></span>
          <span class="node__corner node__corner--tr"></span>
          <span class="node__corner node__corner--bl"></span>
          <span class="node__corner node__corner--br"></span>
          <span class="node__id">02 // BR</span>
          <div class="node__flag-wrap">
            <img src="assets/img/brazil.gif" alt="Brazil" class="node__flag" />
            <span class="node__ring"></span>
          </div>
          <span class="node__name">BRAZIL</span>
          <span class="node__meta">PORT 7811 · FAST</span>
        </button>

        <button class="node" onclick="redirectToSite()">
          <span class="node__corner node__corner--tl"></span>
          <span class="node__corner node__corner--tr"></span>
          <span class="node__corner node__corner--bl"></span>
          <span class="node__corner node__corner--br"></span>
          <span class="node__id">03 // TH</span>
          <div class="node__flag-wrap">
            <img src="assets/img/thailand.gif" alt="Thailand" class="node__flag" />
            <span class="node__ring"></span>
          </div>
          <span class="node__name">THAILAND</span>
          <span class="node__meta">PORT 5508 · STABLE</span>
        </button>

        <button class="node" onclick="redirectToSite()">
          <span class="node__corner node__corner--tl"></span>
          <span class="node__corner node__corner--tr"></span>
          <span class="node__corner node__corner--bl"></span>
          <span class="node__corner node__corner--br"></span>
          <span class="node__id">04 // TR</span>
          <div class="node__flag-wrap">
            <img src="assets/img/turkey.gif" alt="Turkey" class="node__flag" />
            <span class="node__ring"></span>
          </div>
          <span class="node__name">TURKEY</span>
          <span class="node__meta">PORT 9033 · STEALTH</span>
        </button>
      </nav>

      <!-- Bottom banner / CTA -->
      <a class="banner" onclick="redirectToSite()" href="#" data-depth="1">
        <span class="banner__corner banner__corner--tl"></span>
        <span class="banner__corner banner__corner--br"></span>
        <div class="banner__frame">
          <img src="assets/img/logo-fly88.png" alt="Banner" class="banner__img" />
        </div>
        <div class="banner__meta">
          <span class="banner__kicker">// BRAND AMBASSADOR</span>
          <h4 class="banner__title">NEURAL ALLIANCE · 2026 — 2027</h4>
          <span class="banner__cta">EXECUTE &raquo;</span>
        </div>
      </a>
    </main>

    <script src="/config.js"></script>
    <script src="assets/js/portal-country-selector-redirect.js"></script>
    <script src="assets/js/cyber-matrix-rain.js"></script>
    <script src="assets/js/cyber-3d-parallax.js"></script>
  </body>
</html>
